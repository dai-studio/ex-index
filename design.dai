          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_wynjz2vr</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_8v8i8rej" name="Metrics" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:method="GET" dai:path="/metrics" dai:authType="bearer" dai:responseBody="Prometheus text: request counts/latency, per-index vector counts" dai:statusCode="200">
        <bpmn:extensionElements>
