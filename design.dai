    <bpmn:subProcess id="task_ti2zl698" name="Admin UI (/ui)" dai:notes="askama templates + shadcn-html components, served by the same binary. Forms post to thin handlers that call the same store functions as the REST API.">
      <bpmn:task id="task_kxyk0s6a" name="Indexes page" dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="page" dai:propsInterface="GET /ui — table: name, metric, dimension, count, status; actions: open, delete (confirm), rebuild" />
      <bpmn:task id="task_aoex8fu4" name="Create index form" dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="page" dai:propsInterface="GET/POST /ui/new — name, dimension, metric select, advanced params (R, L, alpha, PQ m)" />
      <bpmn:task id="task_dyu7vxe4" name="Index detail" dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="page" dai:propsInterface="GET /ui/indexes/{name} — stats cards, config, JSON textarea to upsert VectorRecords, lookup/delete by id" />
      <bpmn:task id="task_h09holbn" name="Search playground" dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="page" dai:propsInterface="GET/POST /ui/indexes/{name}/search — vector JSON input, k, l_search, filter JSON; results table (rank, id, score, metadata), timing" />
    </bpmn:subProcess>
    <bpmn:task id="task_pextnvvp" name="Server config" dai:type="dai.types.software.config" dai:notes="--host (EX_INDEX_HOST, 0.0.0.0), --port (EX_INDEX_PORT, 7700), --data-dir (EX_INDEX_DATA_DIR, ./data), --api-key (EX_INDEX_API_KEY, unset = auth off), --delta-threshold (50000), --log-level (info)." dai:path="ex-index serve [flags]" dai:source="clap" dai:format="cli flags + env" />
    <bpmn:subProcess id="task_c6zgav4s" name="Requirements" dai:notes="v0.1.0 scope with acceptance criteria.">
      <bpmn:task id="task_9np8dnbb" name="Manage indexes" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="must" dai:source="Goal" dai:acceptanceCriteria="Create/list/get/delete via REST and UI; invalid config rejected with 400; duplicate name 409." />
      <bpmn:task id="task_au43lmpv" name="Ingest vectors + metadata" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="must" dai:source="Goal" dai:acceptanceCriteria="Batch upsert of 10k x 768-d vectors with JSON metadata succeeds; re-upsert replaces; get by id returns stored metadata; delete hides it from search." />
      <bpmn:task id="task_qedjr7x9" name="Similarity search (3 metrics)" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="must" dai:source="Goal" dai:acceptanceCriteria="Cosine, euclidean and dot indexes each return top-k matching brute-force ordering on a 1k-vector fixture (exact match at l_search &#62;= n)." />
      <bpmn:task id="task_3wsadkmp" name="Durability" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="must" dai:acceptanceCriteria="kill -9 after an acknowledged upsert, restart: all acknowledged vectors are present and searchable." />
      <bpmn:task id="task_0kfy83b3" name="Recall" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="must" dai:acceptanceCriteria="recall@10 &#62;= 0.95 vs brute force on 100k x 128-d random/normalized data with default params (l_search=100)." />
      <bpmn:task id="task_umvq7hi2" name="Latency" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="should" dai:acceptanceCriteria="p99 search latency &#60; 10 ms for k=10 on 100k x 128-d on a modern laptop (single query, warm cache). Measured locally with the benchmark, not enforced in CI." />
      <bpmn:task id="task_1y1gvjcs" name="Portable single binary" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="must" dai:source="Goal" dai:acceptanceCriteria="Release workflow builds x86_64 + aarch64 for linux (musl, static), macos and windows; each starts and passes /healthz with no other files present." />
      <bpmn:task id="task_oh8i7lf0" name="Metadata filter" dai:type="dai.types.business.requirement" dai:stepType="requirement" dai:status="agreed" dai:priority="should" dai:acceptanceCriteria="filter {&#34;lang&#34;:&#34;en&#34;} returns only hits whose metadata.lang == &#34;en&#34;. Adaptive over-fetch (k×4, doubling up to l_search×8). Best-effort: highly selective filters may return fewer than k hits; this is documented. In brute-force mode the result is exact." />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_3dah2oc6" name="Tests" dai:notes="cargo test (unit+integration) and cargo bench (criterion) must pass in CI.">
      <bpmn:task id="task_xxhn0aqo" name="Distance metrics" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="unit" dai:testStatus="not-run" dai:testSteps="Compare each metric against a naive reference on random vectors incl. zero/large-norm edge cases.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">abs error &lt; 1e-5; cosine normalization idempotent.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_zwcnssvr" name="Vamana invariants" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="unit" dai:testStatus="not-run" dai:testSteps="Build on 5k vectors; check out-degree &#60;= R, no self loops, graph reachable from medoid.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">All invariants hold; recall@10 &gt;= 0.98 in-memory.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_g5oxvguo" name="PQ round-trip" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="unit" dai:testStatus="not-run" dai:testSteps="Train, encode, decode; compare ADC distance to exact.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">Reconstruction MSE below threshold; ADC ranking correlates (Spearman &gt; 0.9).</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_rll2x5nr" name="REST CRUD + search" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="integration" dai:testStatus="not-run" dai:testSteps="Start server on random port with temp data-dir; exercise every endpoint with reqwest incl. error cases.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">Status codes and bodies match the API spec.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_baeve0rg" name="Restart persistence" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="integration" dai:testStatus="not-run" dai:testSteps="Upsert, delete some, rebuild, upsert more (delta), kill process, restart, search.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">Same results before and after restart; deleted ids absent.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_c9alauf1" name="Auth on/off" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="security" dai:testStatus="not-run" dai:testSteps="Run with and without --api-key; call /v1, /ui, /healthz with missing/wrong/correct token.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">Key set: 401 unless correct token (healthz always 200). Key unset: all open.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_57mwphx2" name="Recall &#38; latency bench" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="performance" dai:testStatus="not-run" dai:testSteps="Run locally (cargo bench): build 100k x 128 index for each metric, 1k queries, compute recall@10 vs brute force and p50/p99 latency.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">recall@10 &gt;= 0.95 for cosine, euclidean and dot; p99 &lt; 10 ms.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_1zq9xbb8" name="UI smoke" dai:type="dai.types.software.test" dai:stepType="test" dai:testType="e2e" dai:testStatus="not-run" dai:testSteps="GET each /ui page; submit create form, upsert form and search form.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="expectedResult">200 responses, rendered tables contain expected rows, assets load from /assets.</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
    </bpmn:subProcess>
    <bpmn:subProcess id="task_lxum0s9y" name="Risks">
      <bpmn:task id="task_xu9q81bm" name="Insert/update complexity" dai:type="dai.types.business.risk-item" dai:stepType="risk" dai:probability="medium" dai:impact="high" dai:mitigation="Delta buffer + background rebuild instead of FreshDiskANN in-place inserts; cover with restart-persistence test." />
      <bpmn:task id="task_y1zmeq41" name="mmap portability (Windows)" dai:type="dai.types.business.risk-item" dai:stepType="risk" dai:probability="medium" dai:impact="medium" dai:mitigation="Use memmap2 only; close mmaps before rename/delete (Windows file locks); run integration tests on windows in CI." />
      <bpmn:task id="task_rzena0ek" name="Build memory blow-up" dai:type="dai.types.business.risk-item" dai:stepType="risk" dai:probability="medium" dai:impact="medium" dai:mitigation="Build from mmapped vectors, PQ-train on a sample, cap rayon threads; document RAM needs per million vectors." />
      <bpmn:task id="task_pdatetq2" name="Dot-product recall" dai:type="dai.types.business.risk-item" dai:stepType="risk" dai:probability="medium" dai:impact="medium" dai:mitigation="MIPS→L2 transform; recall bench covers dot; vectors exceeding max norm stay in delta with exact scoring until rebuild." />
    </bpmn:subProcess>
  </bpmn:process>
