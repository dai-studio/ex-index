<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:dai="https://dai.studio/schema/dai/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="ex-index" targetNamespace="https://dai.studio/workflow">
  <bpmn:process id="Process_1" name="ex-index" isExecutable="false">
    <bpmn:extensionElements>
      <dai:workflowMeta description="Design spec for ex-index: a single-binary Rust vector search server (in-house DiskANN: Vamana + PQ + on-disk layout) with a versioned JSON REST API, optional bearer API key, and a server-rendered shadcn-html admin UI. Supports cosine, euclidean and dot-product search over vectors with JSON metadata. Build sequence lives in plan.dai." version="0.1.0">
        <dai:taskTypeEntry type="dai.types.software.dependency" stepType="dependency" description="An external library, package, service, API, or resource the project relies on. Documents the source, version, type, and license for dependency management and compliance." />
        <dai:taskTypeEntry type="dai.types.ai.context" stepType="context" description="Background knowledge, grounding data, or reference material that informs downstream steps. Does not produce output itself — it shapes how the AI reasons." />
        <dai:taskTypeEntry type="dai.types.ai.rule" stepType="rule" description="A constraint, policy, or business rule the AI must respect and enforce throughout the workflow. Scope, priority, and enforcement level determine how strictly it applies." />
        <dai:taskTypeEntry type="dai.types.software.decision" stepType="" description="A technical or architecture decision record (ADR): the context, the options considered, the decision and its consequences. For business decisions use Business → Decision." />
        <dai:taskTypeEntry type="dai.types.software.component" stepType="component" description="A UI or software component — its type, props/interface, and usage description. Use it to document your component library, design system elements, or reusable building blocks." />
        <dai:taskTypeEntry type="dai.types.software.model" stepType="model" description="A data schema or structured type definition. Documents the shape of data flowing through the system and the notation used." />
        <dai:taskTypeEntry type="dai.types.software.service" stepType="service" description="An external or internal service — its base URL, auth scheme, and version. Provides the context for API Endpoints that call it and documents service boundaries in a distributed system." />
        <dai:taskTypeEntry type="dai.types.software.api-endpoint" stepType="api-endpoint" description="Defines a REST or GraphQL API endpoint — its method, path, auth, and request/response schemas." />
        <dai:taskTypeEntry type="dai.types.software.config" stepType="" description="Configuration for a service or environment: settings, feature switches and secret references, and where they come from." />
        <dai:taskTypeEntry type="dai.types.business.requirement" stepType="requirement" description="A business or functional requirement with priority, source, acceptance criteria, and status. Bridges business goals and technical delivery using the MoSCoW prioritisation framework." />
        <dai:taskTypeEntry type="dai.types.software.test" stepType="test" description="A test case or verification condition — documents what is being tested, how to run it, and what constitutes a pass." />
        <dai:taskTypeEntry type="dai.types.business.risk-item" stepType="risk" description="A potential threat or uncertainty that could negatively affect the project or outcome. Tracks probability, impact, and mitigation." />
      </dai:workflowMeta>
    </bpmn:extensionElements>
    <bpmn:subProcess id="task_gtqssmeo" name="Environment" dai:type="dai.types.software.environment" dai:stepType="environment" dai:notes="Toolchain, algorithm references and crates the single-binary server is built from.">
      <bpmn:extensionElements>
        <dai:fields>
          <dai:field key="envType">local</dai:field>
        </dai:fields>
      </bpmn:extensionElements>
      <bpmn:task id="task_9g19wctk" name="Rust" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:notes="Implement everything in Rust. No C/C++ FFI so the binary cross-compiles to any tier-1/2 target." dai:version="stable (edition 2021)" dai:package="rust (stable toolchain)" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="Implementation language; produces one static binary per target triple." />
      <bpmn:task id="task_h5oppkvj" name="DiskANN (algorithm)" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:notes="Algorithm reference only — implemented in-house in Rust (see decision &#39;Own DiskANN implementation&#39;). Do not link Microsoft&#39;s C++ library." dai:package="DiskANN / Vamana paper (Subramanya et al., NeurIPS 2019)" dai:dependencyType="optional" dai:license="n/a (algorithm reference)" dai:purpose="Indexing algorithm: Vamana graph + PQ-compressed in-RAM vectors + SSD-resident full vectors and adjacency." />
      <bpmn:task id="task_1oi3av4r" name="REST API" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:notes="Use REST for all service interactions" dai:package="HTTP/1.1 + JSON" dai:dependencyType="runtime" dai:purpose="All service interactions (index CRUD, ingest, search) go through versioned /v1 JSON endpoints." />
      <bpmn:task id="task_fmnywgoz" name="HTML (server-side)" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:notes="Use HTML for all UI on the server with server-side templating. No SPA / JS build step." dai:version="0.12" dai:package="askama" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="Compile-time checked server-side HTML templates for the admin UI." />
      <bpmn:task id="task_szbt858b" name="shadcn-html" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:notes="Use shadcn for HTML for all UI elements" dai:package="https://github.com/codylindley/shadcn-html" dai:dependencyType="runtime" dai:license="MIT" dai:purpose="UI component styles/markup for every admin UI element; assets embedded into the binary." />
      <bpmn:task id="task_cygfs1ny" name="axum + tokio" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="axum 0.7 / tokio 1" dai:package="axum, tokio, tower-http" dai:dependencyType="runtime" dai:license="MIT" dai:purpose="Async HTTP server, routing, middleware (auth, tracing, compression)." />
      <bpmn:task id="task_zun3kh0b" name="serde" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="1" dai:package="serde, serde_json" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="JSON (de)serialization of API bodies, metadata and index manifests." />
      <bpmn:task id="task_wlna795e" name="memmap2" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="0.9" dai:package="memmap2" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="Memory-map the on-disk graph/vector files for DiskANN beam search." />
      <bpmn:task id="task_wzaw442g" name="rayon" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="1" dai:package="rayon" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="Parallel Vamana graph build and PQ codebook training." />
      <bpmn:task id="task_9oj8d4ya" name="clap" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="4" dai:package="clap (derive, env)" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="CLI flags with env-var fallbacks for server config." />
      <bpmn:task id="task_cj6072zf" name="tracing" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="0.1 / 0.3" dai:package="tracing, tracing-subscriber" dai:dependencyType="runtime" dai:license="MIT" dai:purpose="Structured logs and request spans." />
      <bpmn:task id="task_ks8mguqd" name="rust-embed" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="8" dai:package="rust-embed" dai:dependencyType="runtime" dai:license="MIT" dai:purpose="Bundle shadcn-html CSS/JS and static assets into the single binary." />
      <bpmn:task id="task_srq3pqhm" name="reqwest + criterion" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:package="reqwest, criterion" dai:dependencyType="dev" dai:license="MIT OR Apache-2.0" dai:purpose="Integration tests against the running server; recall/latency benchmarks." />
      <bpmn:task id="task_ftzzzlyv" name="metrics" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:package="metrics, metrics-exporter-prometheus" dai:dependencyType="runtime" dai:license="MIT" dai:purpose="Counters/histograms exposed at /metrics in Prometheus text format." />
    </bpmn:subProcess>
    <bpmn:task id="task_b6rl5wwq" name="Goal" dai:type="dai.types.ai.context" dai:stepType="context" dai:source="manual" dai:format="text" dai:scope="global" dai:content="A vector index for semantic search in Rust as a single binary server on a port. The service runs on any platform Rust can target and allows end users to create an index, populate it with embedding vectors + JSON metadata, and search for similarity via cosine, euclidean distance, and dot product. " />
    <bpmn:subProcess id="task_g5vhaf26" name="Rules" dai:notes="Hard constraints every implementation step must respect.">
      <bpmn:task id="task_v0oim3n2" name="Single static binary" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="Ship one self-contained executable per target (linux/macos/windows, x86_64 + aarch64). No C/C++ FFI, no runtime asset files: templates and shadcn-html assets are embedded." dai:scope="global" dai:rulePriority="critical" dai:enforcement="hard" />
      <bpmn:task id="task_xew7c8mh" name="All state in --data-dir" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="Every persisted byte lives under the configured data directory (one sub-directory per index). The server must restart and recover all indexes from it." dai:scope="global" dai:rulePriority="high" dai:enforcement="hard" />
      <bpmn:task id="task_f67l7s5z" name="Fixed dimension &#38; metric" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="Each index has a fixed f32 dimension (1..=4096) and a metric (cosine | euclidean | dot) chosen at creation and immutable afterwards. Reject with 400: wrong length, any NaN/±inf component, or a zero-norm vector in a cosine index." dai:scope="global" dai:rulePriority="critical" dai:enforcement="hard" />
      <bpmn:task id="task_7zda4c7w" name="Score semantics" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="Scores are raw per metric; results always sorted best-first. Cosine: vectors L2-normalized on ingest, score = cosine similarity (higher is better). Dot: score = raw inner product of the ORIGINAL vectors (higher is better). Euclidean: score = true L2 distance, sqrt applied (lower is better). Internally ranking uses squared L2 / transformed spaces; conversion to the public score happens only at output." dai:scope="global" dai:rulePriority="high" dai:enforcement="hard" />
      <bpmn:task id="task_sbfs1052" name="Versioned JSON REST" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="All programmatic access is JSON over HTTP under /v1. Errors use {&#34;error&#34;:{&#34;code&#34;,&#34;message&#34;}} with proper status codes." dai:scope="global" dai:rulePriority="high" dai:enforcement="hard" />
      <bpmn:task id="task_qfylzhgi" name="Server-rendered UI only" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="Admin UI is server-side HTML (askama) styled with shadcn-html. Progressive enhancement only; no SPA framework or JS build step." dai:scope="global" dai:rulePriority="high" dai:enforcement="hard" />
      <bpmn:task id="task_06b1jcd3" name="Vector IDs are strings" dai:type="dai.types.ai.rule" dai:stepType="rule" dai:notes="Users supply string IDs; upsert replaces an existing ID. Internally map to dense u32 slots." dai:scope="global" dai:rulePriority="medium" dai:enforcement="hard" />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_nxde8qvc" name="Decisions" dai:notes="Accepted architecture decisions.">
      <bpmn:task id="task_xu2yo5l2" name="Own DiskANN implementation" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="DiskANN reference impl is C++ with OS-specific I/O (libaio/Windows IO); FFI breaks the single-binary, any-target goal." dai:decision="Implement Vamana graph, PQ and the on-disk layout in Rust in the `core` crate." dai:consequences="More engineering and a recall benchmark is required; full control over storage format and portability.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="options">1) FFI to Microsoft DiskANN  2) Third-party Rust crate  3) In-house Rust Vamana + PQ + disk layout</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_isyo1765" name="Optional API key" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="Mostly local/self-hosted use, but must be safe to expose." dai:decision="If --api-key / EX_INDEX_API_KEY is set, every /v1, /ui and /metrics request requires `Authorization: Bearer &#60;key&#62;`; the UI login form instead sets an HttpOnly, SameSite=Strict cookie containing an HMAC of the key, and UI form posts carry a CSRF token. Key compared in constant time. Unset = open. /healthz and /assets always open." dai:consequences="Simple; no multi-tenant isolation in v0.1.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="options">No auth | optional bearer key | full user accounts</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_q8o5ba8o" name="Per-index storage layout" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="Need restart-safe persistence without an external DB." dai:decision="&#60;data-dir&#62;/&#60;index&#62;/: manifest.json (config+stats), graph.bin (main index: header + multi-sector node records holding full vectors + neighbors), pq.bin (codebooks + codes for main), ids.bin (string id &#60;-&#62; slot), tombstones.bin, metadata.log (append-only JSON + in-memory offset map), wal.log (un-merged upserts/deletes; delta vectors are rebuilt from it on start). Full vectors are stored once. Fixed little-endian format." dai:consequences="Index directories are portable across hosts/OSes; compaction writes new files to a temp dir and swaps atomically via rename (mmaps closed first on Windows)." />
      <bpmn:task id="task_py9kyunq" name="Delta buffer + rebuild" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="DiskANN&#39;s static build is best quality; FreshDiskANN-style streaming inserts are complex." dai:decision="Upserts/deletes append to the WAL (fsync before ack) and go to an in-memory Vamana delta. Upserting an existing id tombstones its old slot. Queries search main + delta, merge, drop tombstones. When delta exceeds --delta-threshold (or POST /build), a background rebuild snapshots main+delta; writes arriving during the rebuild go to a fresh delta generation. Swap happens under a short write lock; the WAL is truncated to the new generation." dai:consequences="Writes are durable immediately and searchable immediately; rebuild cost is amortized." />
      <bpmn:task id="task_tgesfeyx" name="Tombstone deletes" dai:type="dai.types.software.decision" dai:status="accepted" dai:decision="Deletes mark a tombstone bitset; tombstoned nodes are traversed but filtered from results. Consolidation happens during rebuild." dai:consequences="O(1) deletes; recall may dip slightly until next rebuild." />
      <bpmn:task id="task_jpwo9vqu" name="Dot via MIPS→L2" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="Vamana&#39;s RobustPrune assumes a metric; raw inner product is not one, so graphs built on it lose recall." dai:decision="For dot indexes, append one coordinate sqrt(M² − ‖x‖²) to each stored vector (M = max norm seen; rebuild re-computes M) and 0 to queries; build and search in L2. Report the raw dot of the original vectors as the score." dai:consequences="Stored dimension is d+1; if a new vector exceeds M it is held in the delta with exact dot scoring until the next rebuild.">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="options">Graph on raw dot | MIPS→L2 transform | require normalized input</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:task id="task_6mctm77l" name="Small-index brute force" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="PQ needs ≥ 256 training vectors and graph/disk overhead is wasteful for tiny indexes." dai:decision="Indexes below 10,000 live vectors are served by exact brute-force search (WAL + in-memory vectors) with no graph/PQ. The first disk build happens automatically when the index crosses the threshold." dai:consequences="Exact results for small indexes; one code path switch to test." />
      <bpmn:task id="task_lmqos97z" name="Repo &#38; CI" dai:type="dai.types.software.decision" dai:status="accepted" dai:decision="git init the project in Scaffold. GitHub Actions: fmt + clippy + test on ubuntu/macos/windows for every push; release workflow on tag cross-builds all targets and attaches binaries. Recall/latency benchmark runs locally only (not a CI gate) because timings are machine-dependent." dai:consequences="Release tagging requires a GitHub remote to be added." />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_ypgwudzm" name="Core Engine (core crate)" dai:notes="Library crate `ex-index-core` holding the DiskANN implementation; the server crate depends on it.">
      <bpmn:task id="task_865aziip" name="distance" dai:type="dai.types.software.component" dai:stepType="component" dai:notes="Internal distances (lower = closer): cosine = 1 - dot on normalized vectors; euclidean = squared L2 (sqrt only when emitting the score); dot = squared L2 in the MIPS-transformed space (see decision &#39;Dot via MIPS→L2&#39;). Chunked loops written for auto-vectorization; optional std::simd behind a feature flag." dai:componentType="library" dai:propsInterface="trait Distance { fn dist(a:&#38;[f32], b:&#38;[f32]) -&#62; f32 }  enum Metric { Cosine, Euclidean, Dot }" />
      <bpmn:task id="task_hg9xekmg" name="vamana" dai:type="dai.types.software.component" dai:stepType="component" dai:notes="Medoid entry point, random R-regular init, two passes (alpha=1 then alpha) of GreedySearch + RobustPrune, parallel with rayon and per-node locks. Also used as the in-memory delta index." dai:componentType="library" dai:propsInterface="struct VamanaParams { r: u32 /*64*/, l_build: u32 /*100*/, alpha: f32 /*1.2*/ }  fn build(&#38;Vectors, Metric, VamanaParams) -&#62; Graph  fn greedy_search(&#38;Graph, q, l) -&#62; Vec&#60;(u32,f32)&#62;" />
      <bpmn:task id="task_4rjdotzf" name="pq" dai:type="dai.types.software.component" dai:stepType="component" dai:notes="Product quantization with k-means per sub-space (sampled training set). Compressed codes stay in RAM and drive graph navigation via asymmetric distance tables." dai:componentType="library" dai:propsInterface="struct PqCodebook { m: usize, ks: 256, centroids: Vec&#60;f32&#62; }  fn train(&#38;Vectors, m) -&#62; PqCodebook  fn encode(&#38;self, v) -&#62; [u8; m]  fn adc_table(&#38;self, q) -&#62; Vec&#60;f32&#62;" />
      <bpmn:task id="task_g3mgfudx" name="disk" dai:type="dai.types.software.component" dai:stepType="component" dai:notes="Node record = header-free [vector f32 × d&#39;] [neighbor_count u32] [neighbors u32 × R], padded up to a multiple of 4096 bytes (multi-sector nodes when needed, so 4096-d is supported). d&#39; = dimension (+1 for dot indexes). File header (sector 0): magic, format version, metric, d&#39;, R, node_size, count, medoid. All integers/floats little-endian. Beam search navigates with PQ distances, reads node sectors via mmap, re-ranks with full vectors." dai:componentType="library" dai:propsInterface="struct DiskIndex { mmap: Mmap, pq: PqCodebook, codes: Vec&#60;u8&#62;, medoid: u32 }  fn search(&#38;self, q, k, l_search, beam_width) -&#62; Vec&#60;Hit&#62;" />
      <bpmn:task id="task_zdnojqyn" name="store" dai:type="dai.types.software.component" dai:stepType="component" dai:notes="Index catalog and lifecycle: WAL append + fsync, string-id&#60;-&#62;slot map, metadata log, tombstones, delta buffer, background rebuild with atomic swap, recovery on startup. Optional metadata equality filter applied to candidates (over-fetch k*factor) before final top-k." dai:componentType="service" dai:propsInterface="struct Catalog { indexes: RwLock&#60;HashMap&#60;String, Arc&#60;Index&#62;&#62;&#62; }  impl Index { upsert, get, delete, search, rebuild, stats }" />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_lesfumoc" name="Models" dai:notes="Wire / persisted data shapes (serde).">
      <bpmn:task id="task_rinfusmk" name="IndexConfig" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="name: str (^[a-z0-9_-]{1,64}$), dimension: int (1..=4096), metric: &#34;cosine&#34;|&#34;euclidean&#34;|&#34;dot&#34;, params?: { r: int=64, l_build: int=100, alpha: float=1.2, pq_subvectors: int=ceil(dimension/4) (last sub-vector zero-padded; must be 1..=dimension), l_search: int=100 }" dai:modelFormat="json-schema" />
      <bpmn:task id="task_qmn3t201" name="VectorRecord" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="id: str (1..256 chars), vector: list[float] (len = dimension), metadata?: dict (arbitrary JSON object, ≤ 64 KiB)" dai:modelFormat="json-schema" />
      <bpmn:task id="task_zlpq3j0j" name="SearchRequest" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="vector: list[float], k: int=10 (1..1000), l_search?: int (&#62;= k), filter?: dict (top-level metadata key == value, AND-ed), include_vector: bool=false, include_metadata: bool=true" dai:modelFormat="json-schema" />
      <bpmn:task id="task_lcs0yxga" name="SearchHit" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="id: str, score: float (see Score semantics rule), metadata?: dict, vector?: list[float].  Response: { hits: [SearchHit], took_ms: float }" dai:modelFormat="json-schema" />
      <bpmn:task id="task_gkqfn7w5" name="IndexInfo" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="config: IndexConfig, count: int, deleted: int, delta_count: int, status: &#34;ready&#34;|&#34;building&#34;, built_at?: datetime, size_bytes: int" dai:modelFormat="json-schema" />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_qqgmv0qw" name="REST API" dai:notes="axum router. All /v1 routes require `Authorization: Bearer &#60;key&#62;` only when an API key is configured. JSON errors: {&#34;error&#34;:{&#34;code&#34;:&#34;not_found|invalid_argument|conflict|unauthorized|internal&#34;,&#34;message&#34;:str}}.">
      <bpmn:task id="task_daxpnev3" name="ex-index server" dai:type="dai.types.software.service" dai:stepType="service" dai:notes="Single binary `ex-index serve`. Serves /v1 JSON API, /ui admin pages, /assets (embedded), /healthz, /metrics. Request body limit 64 MiB, ≤ 10k vectors per upsert. Graceful shutdown on SIGINT/SIGTERM: stop accepting, finish in-flight requests, fsync WALs." dai:version="v1" dai:authType="bearer" dai:baseUrl="http://0.0.0.0:7700">
        <bpmn:outgoing>flow_az5bq4bk</bpmn:outgoing>
        <bpmn:outgoing>flow_e0g91c0t</bpmn:outgoing>
        <bpmn:outgoing>flow_no6etifi</bpmn:outgoing>
        <bpmn:outgoing>flow_mezc1twn</bpmn:outgoing>
        <bpmn:outgoing>flow_myxwm61s</bpmn:outgoing>
        <bpmn:outgoing>flow_7irq6zvz</bpmn:outgoing>
        <bpmn:outgoing>flow_u6weg80p</bpmn:outgoing>
        <bpmn:outgoing>flow_ndxr4j3c</bpmn:outgoing>
        <bpmn:outgoing>flow_d54879vl</bpmn:outgoing>
        <bpmn:outgoing>flow_wynjz2vr</bpmn:outgoing>
        <bpmn:outgoing>flow_pcq897ta</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="task_lou8g1mr" name="Create index" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="409 if the name exists; 400 on invalid dimension/metric/params." dai:method="POST" dai:path="/v1/indexes" dai:authType="bearer" dai:requestBody="IndexConfig" dai:responseBody="IndexInfo" dai:statusCode="201">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_az5bq4bk</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_m1odi9lb" name="List indexes" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:method="GET" dai:path="/v1/indexes" dai:authType="bearer" dai:responseBody="{ indexes: [IndexInfo] }" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
