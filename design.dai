        <bpmn:incoming>flow_e0g91c0t</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_wzq11on2" name="Get index" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="404 if missing." dai:method="GET" dai:path="/v1/indexes/{name}" dai:authType="bearer" dai:responseBody="IndexInfo" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_no6etifi</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_3flubl7g" name="Delete index" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Removes the index directory after closing mmaps." dai:method="DELETE" dai:path="/v1/indexes/{name}" dai:authType="bearer" dai:statusCode="204">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_mezc1twn</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_ruc6p1zj" name="Upsert vectors" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Durable (WAL fsync) and searchable on return. Whole batch rejected with 400 if any vector has the wrong dimension or a non-finite value." dai:method="POST" dai:path="/v1/indexes/{name}/vectors" dai:authType="bearer" dai:requestBody="{ vectors: [VectorRecord] } (≤ 10k per request)" dai:responseBody="{ upserted: int }" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_myxwm61s</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_wqwwrvyw" name="Get vector" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:method="GET" dai:path="/v1/indexes/{name}/vectors/{id}" dai:authType="bearer" dai:responseBody="VectorRecord" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_7irq6zvz</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_dljfggu7" name="Delete vector" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Tombstones the slot." dai:method="DELETE" dai:path="/v1/indexes/{name}/vectors/{id}" dai:authType="bearer" dai:statusCode="204">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_u6weg80p</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_3thfd20m" name="Search" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Searches main disk index (or brute force for small indexes) + delta, merges, drops tombstones, applies filter with adaptive over-fetch, returns top-k best-first with raw per-metric scores." dai:method="POST" dai:path="/v1/indexes/{name}/search" dai:authType="bearer" dai:requestBody="SearchRequest" dai:responseBody="{ hits: [SearchHit], took_ms: float }" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_ndxr4j3c</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_4zyvfdik" name="Rebuild index" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Starts a background merge/compaction; 409 if a build is already running." dai:method="POST" dai:path="/v1/indexes/{name}/build" dai:authType="bearer" dai:responseBody="IndexInfo (status=building)" dai:statusCode="202">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">ex-index server</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_d54879vl</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="task_2prz3cnx" name="Health" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:method="GET" dai:path="/healthz" dai:authType="none" dai:responseBody="{ status: &#34;ok&#34;, version: str }" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
