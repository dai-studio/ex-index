    <bpmn:task id="task_4b64umb1" name="Tombstones + rebuild" dai:notes="Bitset tombstones per segment (checkpointed to tombstones.bin on flush). start_build: rotate WAL + freeze active delta under wal+state locks, background std::thread builds main.&#60;gen&#62;.tmp → rename → manifest commit; swap under short write lock applying ids touched during the build as tombstones; old mmap dropped before old dir removal; 409 if already building; auto-trigger at --delta-threshold. Builder aborts on index delete." dai:agentStatus="done" dai:planRef="task_9tlovknd">
